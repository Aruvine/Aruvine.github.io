{
  "c": {
    "body": {
      "kind": "static"
    },
    "display": {
      "kind": "badge",
      "showWithin": 15,
      "text": "Time: {var:self.left}"
    },
    "shape": {
      "model": {
        "prim": "box",
        "size": [
          0.3,
          1.8,
          0.3
        ]
      },
      "tint": "#5aa0c8"
    },
    "vars": {
      "left": {
        "init": 0,
        "label": "Seconds left",
        "scope": "entity",
        "type": "number"
      }
    }
  },
  "cards": [
    {
      "do": [
        {
          "act": "setVar",
          "op": "set",
          "value": {
            "dial": "seconds"
          },
          "var": "self.left"
        }
      ],
      "id": "begin",
      "label": "When asked to begin, count from the start",
      "on": {
        "event": "signal",
        "name": "begin"
      }
    },
    {
      "do": [
        {
          "act": "if",
          "cond": {
            "cmp": {
              "a": {
                "read": "var:self.left"
              },
              "b": 0,
              "op": ">"
            }
          },
          "then": [
            {
              "act": "setVar",
              "op": "add",
              "value": -1,
              "var": "self.left"
            }
          ]
        }
      ],
      "id": "tick",
      "label": "Each second count down to 0",
      "on": {
        "event": "timer",
        "every": 1
      }
    }
  ],
  "dials": [
    {
      "default": 10,
      "id": "seconds",
      "label": "Counts from",
      "max": 600,
      "min": 1,
      "step": 1,
      "unit": "s"
    }
  ],
  "id": "timer_post",
  "ideas": [
    {
      "do": [
        {
          "act": "setVar",
          "op": "set",
          "value": {
            "dial": "seconds"
          },
          "var": "self.left"
        }
      ],
      "id": "begin_at_start",
      "label": "When the world starts, begin",
      "on": {
        "event": "start"
      }
    },
    {
      "do": [
        {
          "act": "signal",
          "name": "open",
          "to": {
            "filter": {
              "tagsAny": [
                "door"
              ]
            },
            "from": "around",
            "limit": 1,
            "order": "nearest",
            "r": 32,
            "shape": "sphere"
          }
        }
      ],
      "id": "open_on_time_up",
      "label": "When the time is up, open the door",
      "on": {
        "event": "var",
        "reaches": 0,
        "var": "self.left"
      }
    },
    {
      "do": [
        {
          "act": "setVar",
          "op": "set",
          "value": {
            "dial": "seconds"
          },
          "var": "self.left"
        }
      ],
      "id": "again_on_time_up",
      "label": "When the time is up, begin again",
      "on": {
        "event": "var",
        "reaches": 0,
        "var": "self.left"
      }
    }
  ],
  "kind": "gadget",
  "label": "Timer post",
  "schemaVersion": 2,
  "tags": [
    "timer"
  ]
}
